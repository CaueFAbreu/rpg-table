rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isMestre(salaId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/salas/$(salaId)).data.mestreId == request.auth.uid;
    }

    // Jogador removido pelo mestre fica registrado em salas/{salaId}/bloqueados/{uid}
    // e perde o acesso de leitura e escrita a sala.
    function isMember(salaId) {
      return isSignedIn()
        && !exists(/databases/$(database)/documents/salas/$(salaId)/bloqueados/$(request.auth.uid));
    }

    match /salas/{salaId} {
      // A sala so pode ser lida pelo ID (get). Listar todas as salas e proibido:
      // o ID aleatorio funciona como convite/link secreto.
      allow get: if isMember(salaId);
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.mestreId == request.auth.uid;

      allow update: if isSignedIn()
        && (
          resource.data.mestreId == request.auth.uid
          || (
            !resource.data.keys().hasAny(["mestreId"])
            && request.resource.data.mestreId == request.auth.uid
          )
        );

      allow delete: if false;

      match /personagens/{personagemId} {
        allow read: if isMember(salaId);

        allow create: if isMember(salaId)
          && request.resource.data.ownerId == request.auth.uid;

        allow update: if isMember(salaId)
          && (
            (
              resource.data.ownerId == request.auth.uid
              && request.resource.data.ownerId == resource.data.ownerId
            )
            || (
              isMestre(salaId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["iniciativa"])
            )
          );

        // O dono exclui o proprio personagem; o mestre tambem pode (remocao de jogador).
        allow delete: if isMember(salaId)
          && (
            resource.data.ownerId == request.auth.uid
            || isMestre(salaId)
          );
      }

      match /rolls/{rollId} {
        allow read: if isMember(salaId);

        allow create: if isMember(salaId)
          && request.resource.data.userId == request.auth.uid;

        allow update: if false;

        allow delete: if isMestre(salaId);
      }

      match /extras/{extraId} {
        allow read: if isMember(salaId);

        allow create: if isMestre(salaId)
          && request.resource.data.createdBy == request.auth.uid;

        allow update, delete: if isMestre(salaId);
      }

      match /jogadores/{userId} {
        allow read: if isMember(salaId);

        allow create, update: if isMember(salaId)
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;

        // O jogador sai por conta propria; o mestre tambem pode remove-lo.
        allow delete: if isMember(salaId)
          && (userId == request.auth.uid || isMestre(salaId));
      }

      // Jogadores removidos pelo mestre. Cada um pode ler apenas o proprio registro
      // (para saber que foi removido); so o mestre lista, cria e apaga (readmitir).
      match /bloqueados/{userId} {
        allow get: if isSignedIn()
          && (userId == request.auth.uid || isMestre(salaId));

        allow list: if isMestre(salaId);

        allow create: if isMestre(salaId)
          && userId != request.auth.uid
          && request.resource.data.keys().hasOnly(["nome", "bloqueadoPor", "bloqueadoEm"])
          && request.resource.data.bloqueadoPor == request.auth.uid;

        allow update: if false;

        allow delete: if isMestre(salaId);
      }

      // Area privada do mestre (nao e legivel pelos jogadores). Hoje guarda os Pontos de Medo.
      match /mestre/{docId} {
        allow read: if isMestre(salaId);

        allow create, update: if isMestre(salaId)
          && docId == "medo"
          && request.resource.data.keys().hasOnly(["pontos", "updatedAt"])
          && request.resource.data.pontos is int
          && request.resource.data.pontos >= 0
          && request.resource.data.pontos <= 999;

        allow delete: if false;
      }
    }
  }
}
